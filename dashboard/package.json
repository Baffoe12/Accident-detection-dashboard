{
  "name": "safedrive-dashboard",
  "version": "1.0.0",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "app": "electron .",
    "electron-dev": "cross-env ELECTRON_START_URL=http://localhost:3000 concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^5.11.0",
    "@mui/material": "^5.11.0",
    "chart.js": "^4.2.1",
    "framer-motion": "^12.8.0",
    "jspdf": "^3.0.1",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.8.1",
    "react-scripts": "^5.0.1",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^26.4.0",
    "electron-builder": "^24.9.0",
    "wait-on": "^7.0.1",
    "jest": "^29.7.0",
    "path-browserify": "^1.0.1",
    "supertest": "^6.3.4"
  },
  "build": {
    "appId": "com.safedrive.dashboard",
    "productName": "SafeDrive Dashboard",
    "files": [
      "build/**/*",
      "electron-main.js",
      "electron-preload.js"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "ansi-styles": "^4.3.0"
  }
}
